      "name": "主要行动",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "铜褐实底行动，包含真实 hover / active / disabled / focus。",
      "html": "<button type=\"button\" class=\"ds-primary\">接着聊</button>",
      "css": ".ds-primary{font-family:var(--body,-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif);color:var(--ink,#302820);font-size:14px;line-height:1.7}.ds-primary :where(button,input,textarea,select){font:inherit;color:inherit}:is(.ds-primary):is(button){border:0;background:none;cursor:pointer;transition:background-color 160ms,color 160ms}:is(.ds-primary):is(button):disabled{cursor:default;opacity:.5}:is(.ds-primary):is(button):hover:not(:disabled){color:var(--accent,#8a432b)}:is(.ds-primary):is(button,summary,input,select):focus-visible{outline:2px solid var(--focus,#a35c36);outline-offset:5px}.ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--accent,#8a432b);color:var(--on-accent,#fff9f0);border-radius:8px;padding:11px 17px;min-height:42px;font-size:13px}.ds-primary:hover:not(:disabled){background:color-mix(in srgb,var(--accent,#8a432b) 88%,var(--ink,#302820));color:var(--on-accent,#fff9f0)}.ds-primary:active:not(:disabled){transform:scale(.98)}"
    },
    {
      "name": "次要行动",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "细边框辅助行动，hover 使用纸张浅洗色。",
      "html": "<button type=\"button\" class=\"ds-secondary\">体验目录授权</button>",
      "css": ".ds-secondary{font-family:var(--body,-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif);color:var(--ink,#302820);font-size:14px;line-height:1.7}.ds-secondary :where(button,input,textarea,select){font:inherit;color:inherit}:is(.ds-secondary):is(button){border:0;background:none;cursor:pointer;transition:background-color 160ms,color 160ms}:is(.ds-secondary):is(button):disabled{cursor:default;opacity:.5}:is(.ds-secondary):is(button):hover:not(:disabled){color:var(--accent,#8a432b)}:is(.ds-secondary):is(button,summary,input,select):focus-visible{outline:2px solid var(--focus,#a35c36);outline-offset:5px}.ds-secondary{border:1px solid var(--line,#ded5c9);padding:9px 14px;min-height:40px;border-radius:6px;font-size:12px}.ds-secondary:hover{background:var(--wash,#eee3d4)}"
    },
    {
      "name": "自然对话输入",
      "kind": "input",

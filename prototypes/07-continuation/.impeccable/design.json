  "narrative": {
    "northStar": "每个被搁置的念头，都可以有下一页。",
    "overview": "一个安静的个人项目Agent。主画面围绕一段正在发生的对话，首屏一句具体发现与输入框形成连续关系；项目和设置只通过角落入口访问。故事通过记住项目、继续讨论成立。",
    "keyCharacteristics": [
      "对话是主操作，判断融入消息，依据按需展开。",
      "中文阅读优先，材料与推断分层。",
      "安静背景、清晰动作、低存在感品牌。"
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "色彩不能代替“示例、推测、未知”的文字说明。",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "标题先说清楚判断，再用字号表达层次。",
        "section": "typography"
      }
    ],
    "dos": [
      "Do 让用户打开就能输入，一条判断作为对话开场。",
      "Do 让用户随时看见讨论范围、材料来源与未知部分。",
      "Do 将新发现接回原项目对话。"
    ],
    "donts": [
      "Don't 把合成材料或预设回复包装为真实研究。",
      "Don't 用热度、生命值或装饰性仪表盘决定项目价值。",
      "Don't 让背景故事盖过用户的项目。"
    ]
  }

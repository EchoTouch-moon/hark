{
  "name": "@hark/agent-host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:pi-sdk-smoke": "node --experimental-strip-types --test test/sandbox-smoke.test.ts",
    "test:host": "node --experimental-strip-types --test test/ipc.test.ts test/host-runtime.test.ts test/memory-tools.test.ts",
    "test:stepfun-session": "node --experimental-strip-types --test test/stepfun-session.test.ts test/outbound-request.test.ts",
    "test:stepfun-live-check": "node --experimental-strip-types --test test/stepfun-live-check.test.ts",
    "probe:host-stdio": "node --experimental-strip-types scripts/stdio-probe.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "typebox": "1.3.27",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.8.3"
  }
}

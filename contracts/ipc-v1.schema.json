{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hark.local/contracts/ipc-v1.schema.json",
  "title": "Hark IPC v1 frame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "kind",
    "id",
    "replyTo",
    "workspaceId",
    "runId",
    "method",
    "deadlineUnixMs",
    "payload",
    "error"
  ],
  "properties": {
    "v": { "const": 1 },
    "kind": { "enum": ["request", "response", "event", "error"] },
    "id": { "$ref": "#/$defs/id" },
    "replyTo": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "workspaceId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/workspaceId" }] },
    "runId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runId" }] },
    "method": { "type": "string", "minLength": 1, "maxLength": 128 },
    "deadlineUnixMs": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "payload": { "type": "object" },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/errorBody" }] }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^(req|evt|err|ws|run|root|src|msg|scan|cand|op|tool|grant|agt|conv|onb)_[0-9a-f]{32}$"
    },
    "workspaceId": {
      "type": "string",
      "pattern": "^ws_[0-9a-f]{32}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{32}$"
    },
    "errorBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    }
  }
}

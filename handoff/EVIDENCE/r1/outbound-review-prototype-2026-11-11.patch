 impl Core {
+    /// Verify each recorded source against its current on-disk content through
+    /// the same constrained reader used by workspace tools. Never writes a
+    /// new source while checking, and fails closed on incomplete snapshots.
+    pub fn outbound_source_version(&self, workspace_id: &WorkspaceId) -> Result<String> {
+        let (ws, root) = self.workspace_and_root(workspace_id)?;
+        grant::require_active(&root)?;
+        let before =
+            self.with_conn(|conn| crate::outbound::source_fingerprint(conn, workspace_id))?;
+        let sources = self.list_source_refs(workspace_id)?;
+        let total = sources
+            .iter()
+            .try_fold(0_u64, |sum, source| sum.checked_add(source.byte_len));
+        if sources.len() > 128 || total.is_none_or(|bytes| bytes > 8 * 1024 * 1024) {
+            return Err(CoreError::new(
+                ErrorCode::ModelNotAuthorized,
+                "source verification budget exceeded",
+            ));
+        }
+        for source in sources {
+            if source.truncated || !source.content_available {
+                return Err(CoreError::new(
+                    ErrorCode::ModelNotAuthorized,
+                    "source incomplete",
+                ));
+            }
+            let read = read_checked(self, &root, &ws, &source.relative_path, source.byte_len)?;
+            if read.truncated
+                || read.bytes.len() as u64 != source.byte_len
+                || hex::encode(Sha256::digest(&read.bytes)) != source.content_sha256
+            {
+                return Err(CoreError::new(
+                    ErrorCode::ModelNotAuthorized,
+                    "source content changed",
+                ));
+            }
+        }
+        let after =
+            self.with_conn(|conn| crate::outbound::source_fingerprint(conn, workspace_id))?;
+        if before != after {
+            return Err(CoreError::new(
+                ErrorCode::ModelNotAuthorized,
+                "source set changed",
+            ));
+        }
+        grant::require_active(&self.get_root(&root.id)?)?;
+        Ok(after)
+    }

{
  "productName": "Hark R1 Dev",
  "version": "0.1.0",
  "identifier": "dev.hark.r1.native-shell",
  "build": {
    "beforeDevCommand": "npm run dev -w @hark/desktop-ui --prefix ../../..",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build -w @hark/desktop-ui --prefix ../../..",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "Hark",
        "width": 1120,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

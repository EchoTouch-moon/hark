  "narrative": {
    "northStar": "每个被搁置的念头，都可以有下一页。",
    "overview": "个人研究助理的阅览工作台。窄索引承载导航，工作区围绕一个具体项目给出判断；可读档案与页边便笺承载材料与推断。故事通过阅读、翻开、继续讨论发生。",
    "keyCharacteristics": [
      "单一当前判断，依据按需展开。",
      "中文阅读优先，材料与推断分层。",
      "安静背景、清晰动作、低存在感品牌。"
    ],
    "rules": [
      {
        "name": "The Evidence Rule",
        "body": "色彩不能代替“示例、推测、未知”的文字说明。",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "标题先说清楚判断，再用字号表达层次。",
        "section": "typography"
      }
    ],
    "dos": [
      "Do 把具体项目与一句判断放在主要位置。",
      "Do 让用户随时看见讨论范围、材料来源与未知部分。",
      "Do 将新发现接回原项目对话。"
    ],
    "donts": [
      "Don't 把合成材料或预设回复包装为真实研究。",
      "Don't 用热度、生命值或装饰性仪表盘决定项目价值。",
      "Don't 让背景故事盖过用户的项目。"
    ]
  }

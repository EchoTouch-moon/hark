{
  "name": "hearth",
  "private": true,
  "version": "0.1.0",
  "description": "Hearth — local-first personal intelligence agent (demo closed loop)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @hearth/web typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @hearth/web build && pnpm --filter @hearth/server build",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "dev:server": "pnpm --filter @hearth/server dev",
    "dev:web": "pnpm --filter @hearth/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
{
  "identifier": "desktop-dev",
  "description": "Thin Chinese dev window. Directory grants come from the Rust picker token, not from a frontend path. No fs, shell, dialog, or allow-all permissions.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-pick-directory",
    "allow-authorize-picked",
    "allow-list-roots",
    "allow-pause-directory",
    "allow-resume-directory",
    "allow-revoke-directory",
    "allow-scan-root",
    "allow-cancel-scan",
    "allow-get-scan",
    "allow-confirm-import",
    "allow-list-workspaces",
    "allow-get-workspace",
    "allow-selective-key-read",
    "allow-cancel-read",
    "allow-list-source-refs",
    "allow-get-source-ref",
    "allow-workspace-overview",
    "allow-commit-local-scan-card",
    "allow-list-conversation",
    "allow-append-user-message",
    "allow-onboarding",
    "allow-cancel-onboarding",
    "allow-retry-onboarding",
    "allow-service-grants",
    "allow-sidecar-status",
    "allow-start-configured-opening",
    "allow-start-agent-turn",
    "allow-get-agent-turn",
    "allow-cancel-agent-turn",
    "allow-hide-window",
    "allow-quit-app",
    "allow-shell-snapshot",
    "allow-configure-stepfun-session",
    "allow-clear-stepfun-session",
    "allow-stepfun-session-status",
    "allow-set-model-grant",
    "allow-get-opinion",
    "allow-list-workspace-opinions",
    "allow-submit-opinion-feedback",
    "allow-revert-memory-operation",
    "allow-search-workspace-memory",
    "allow-get-message-evidence",
    "allow-list-memory-receipts"
  ]
}

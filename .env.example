# Explicit Pi + StepFun settings. Leave HARK_MODEL_MODE unset or `disabled` to make no model request.
# HARK_MODEL_MODE=pi
# HARK_PI_BIN=/absolute/path/to/pi
# HARK_PI_PROVIDER=stepfun-plan
# HARK_PI_MODEL=step-5-preview
# HARK_PI_PROVIDER_EXTENSION=/absolute/path/to/pi-provider-stepfun/src/index.ts
# HARK_PI_PASS_PROVIDER_ENV=STEP_PLAN_API_KEY
# HARK_MODEL_WORKDIR=/absolute/path/to/an/empty/directory
# HARK_MODEL_TIMEOUT_MS=90000
# HARK_MODEL_MAX_OUTPUT_BYTES=65536
# HARK_MODEL_MAX_CALLS=20
# The credential itself belongs in the named environment variable, never in this file.
